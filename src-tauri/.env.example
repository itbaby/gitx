# Example environment variables for src-tauri/.env
# Keep real secrets out of the repository. Put real values in src-tauri/.env (gitignored).

# AI model configuration
AI_MODEL=glm-4-flash
# OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Sampling temperature and output token cap (defaults shown).
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4000

# JSON field used to send the token cap. OpenAI's current API expects
# `max_completion_tokens`, but many OpenAI-compatible gateways (e.g. BigModel)
# only accept the legacy `max_tokens`. Set to `max_tokens` if your provider
# rejects requests with a 400 on `max_completion_tokens`.
AI_MAX_TOKENS_FIELD=max_completion_tokens
